{
  "name": "10-frontend-auth",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "@types/bun": "^1.3.4",
      "@cloudflare/workers-types": "^4.20251213.0",
      "@trpc/server": "^11.13.4",
      "better-auth": "1.5.5",
      "@types/express": "^5.0.1",
      "lucide-react": "^0.546.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.3",
      "react-dom": "^19.2.3",
      "sonner": "^2.0.5",
      "@libsql/client": "0.15.15",
      "libsql": "0.5.22",
      "@trpc/client": "^11.13.4",
      "@types/react": "^19.2.10",
      "@types/react-dom": "^19.2.3",
      "tailwindcss": "^4.1.18",
      "alchemy": "^0.90.0",
      "drizzle-orm": "^0.45.1"
    }
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @10-frontend-auth/db db:push",
    "db:studio": "turbo -F @10-frontend-auth/db db:studio",
    "db:generate": "turbo -F @10-frontend-auth/db db:generate",
    "db:migrate": "turbo -F @10-frontend-auth/db db:migrate",
    "db:local": "turbo -F @10-frontend-auth/db db:local",
    "deploy": "turbo -F @10-frontend-auth/infra deploy",
    "destroy": "turbo -F @10-frontend-auth/infra destroy",
    "check": "biome check --write ."
  },
  "packageManager": "bun@1.3.9",
  "dependencies": {
    "dotenv": "catalog:",
    "zod": "catalog:",
    "@10-frontend-auth/env": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/bun": "catalog:",
    "@10-frontend-auth/config": "workspace:*",
    "@cloudflare/workers-types": "catalog:",
    "turbo": "^2.8.12",
    "@biomejs/biome": "^2.2.0",
    "lefthook": "^2.0.13"
  }
}
