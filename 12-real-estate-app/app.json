{
  "expo": {
    "name": "PropertyHub",
    "slug": "propertyhub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon/real-estate-app-icon.png",
    "scheme": "realestateapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/app-icon/real-estate-app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": ["./assets/fonts/RemachineScript_Personal_Use.ttf"]
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
